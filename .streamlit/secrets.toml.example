# Copy semua ini ke Streamlit → Manage app → ⋮ → Settings → Secrets, lalu ganti nilainya.
# JANGAN commit file secrets.toml asli ke GitHub.
# PENTING: tulis semua baris biasa DI ATAS bagian gcp_json.

# Google Sheet database poin (boleh URL lengkap atau ID saja)
GSHEET_URL = "https://docs.google.com/spreadsheets/d/ID_SHEET/edit"

# Master customer (hanya dibaca)
CUSTOMER_SHEET_ID = "ID_SHEET_MASTER_CUSTOMER"

# AI pembaca nota (Google AI Studio)
GEMINI_API_KEY = "ISI_API_KEY_GEMINI"
GEMINI_MODEL = "gemini-2.0-flash"

# Upload foto ke Drive lewat Apps Script (FotoAPI.gs)
FOTO_SCRIPT_URL = "https://script.google.com/macros/s/xxxx/exec"
FOTO_TOKEN = "token-rahasia-bebas"

# Kunci acak untuk sesi login (isi teks acak panjang)
SESSION_SECRET = "ganti-dengan-teks-acak-panjang"

# Service account Google: tempel UTUH isi file .json dari { sampai }
gcp_json = '''
{ TEMPEL ISI FILE .JSON DI SINI }
'''

# Notif WA kalau aplikasi error (CallMeBot). Taruh di bagian paling bawah.
[callmebot]
phone = "+628xxxxxxxxxx"
apikey = "ISI_APIKEY_DARI_CALLMEBOT"
